# Copy to .env and adjust before the first `docker compose up -d`.
# These values are only used while ./data/config.json does not exist.
# Afterwards, edit ./data/config.json instead (listen_host/listen_port changes
# still require a restart).

# Interface and host port exposed on your machine. Set TINYHUTCH_BIND to
# 127.0.0.1 when a reverse proxy on this host is the only entry point.
TINYHUTCH_BIND=0.0.0.0
TINYHUTCH_PORT=7500

# Container listen port (keep it equal to the container side of the port
# mapping; only change both if you know what you are doing).
TINYHUTCH_LISTEN_PORT=7500

# Admin password. Leave this line out to generate a random password on first
# start (printed in `docker compose logs`). Set it to an empty value to disable
# the admin password entirely (not recommended).
# TINYHUTCH_ADMIN_PASSWORD=change-me

TINYHUTCH_SITE_NAME=TinyHutch
TINYHUTCH_SESSION_HOURS=12
TINYHUTCH_MAX_UPLOAD_MB=4096
TINYHUTCH_SHOW_HIDDEN=false
TINYHUTCH_LOG_LEVEL=info

# Set both to true/false appropriately when running behind an HTTPS reverse
# proxy. INSECURE_COOKIE must be false over HTTPS.
TINYHUTCH_TRUST_PROXY=false
TINYHUTCH_INSECURE_COOKIE=true

# Optional path locks, as a JSON array. Example:
# TINYHUTCH_RULES=[{"path":"/private","password":"secret"}]
TINYHUTCH_RULES=[]
